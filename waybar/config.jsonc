{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 10,

    // Membagi modul menjadi beberapa "island" mengapung
    "modules-left": ["ext/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": ["cpu", "memory", "battery", "network", "clock", "custom/power"],

    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "mpris": {
        "format": "󰓇  {artist} - {title}",
        "format-paused": "󰏤  {status_icon} {artist} - {title}",
        "max-length":40,
        "player": "spotify"
    },
    "cpu": {
        "format": "  {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "   {percentage}%",
        "interval": 2
    },
    "battery":{
        "format": "󰂄   {capacity}% {power}w",
        "format-charging": "󱐋 {capacity}% {time} {power}w",
        "battery-icons": ["󱊡  ", "󱊢  ", "󱊣  "],
        "warning": 25,
        "interval": 2
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {essid}",
        "format-disconnected": "󰤭  Offline"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 2",
        "tooltip": false
    }
}
