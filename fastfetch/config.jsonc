//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  GROUPS
//
//  by Bina

  
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "<your picture location>",
    	"type": "kitty",
      	"height": 15,
      	"padding": {
    		"top": 5,
    		"left": 2,
      	}
    },
    "display": {
        "color":{
            "keys": "magenta",
            "title": "bright_magenta",
            "output": "38;2;240;230;240"
        },
          "separator": " 🌸 "
    },
    "modules": [
        "break",
        "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "38;2;255;182;193",  // = color1
            "format": "\u001b[38;2;200;245;255m{1} \u001b[38;2;218;112;214m{2} ",
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "38;2;255;182;193",
            "format": "\u001b[38;2;200;245;255m{1} \u001b[38;2;218;112;214m{2}\u001b[0m 󰣇"
        },
        {
            "type": "uptime",
            "format": "\u001b[38;2;230;190;255m{2} \u001b[38;2;200;245;255m(Hrs), \u001b[38;2;230;190;255m{3} \u001b[38;2;200;245;255m(Mins)",
            "key": " ├  ",
            "keyColor": "38;2;255;182;193",
        },
        {
            "type": "packages",
            "formate": "\u001b[38;2;230;190;255m{1} \u001b[38;2;200;245;255m(pacman)",
            "key": " ├ 󰏖 ",
            "keyColor": "38;2;255;182;193",
            "packagemanagers": ["pacman"],
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "38;2;255;182;193",
            "format": "\u001b[38;2;200;245;255m{1} \u001b[38;2;218;112;214m{4}"
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{2} ({3})",
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{1}",
        },
        {
            "type": "de",
            "key": " ├ 󰧨 ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{2} \u001b[38;2;218;112;214m{3}"
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{1}, {2}"
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{1} ({2}px)"
        },
        {
            "type": "terminal",
            "key": " └  ",
            "keyColor": "38;2;218;112;214",
            "format": "\u001b[38;2;200;245;255m{3} \u001b[38;2;218;112;214m{6}"
        },
        "break",
        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": "PC   ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;200;245;255m{2}"
        },
        {
            "type": "cpu",
            "format": "\u001b[38;2;200;245;255m{1} {4} Core(s) ({3}) \u001b[38;2;218;112;214m@ {6}",
            "key": " ├  ",
            "keyColor": "38;2;224;255;255",
        },
        {
            "type": "gpu",
            "format": "\u001b[38;2;200;245;255m{1} {2} \u001b[38;2;218;112;214m@ {12}",
            "key": " ├ 󰢮 ",
            "keyColor": "38;2;224;255;255",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;218;112;214m{1}\u001b[0m / \u001b[38;2;218;112;214m{2}\u001b[0m (\u001b[38;2;218;112;214m{3}\u001b[0m)"
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;218;112;214m{1}\u001b[0m / \u001b[38;2;218;112;214m{2}\u001b[0m (\u001b[38;2;218;112;214m{3}\u001b[0m)"
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;218;112;214m{1} \u001b[0m/ \u001b[38;2;218;112;214m{2} \u001b[0m({3}) \u001b[38;2;200;245;255m[{9}]"
        },
        {
            "type": "monitor",
            "key": " ├  ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;200;245;255m{1} \u001b[38;2;218;112;214m{2}\u001b[38;2;200;245;255mx\u001b[38;2;218;112;214m{3} @ {11} \u001b[38;2;200;245;255mHz"
        },
        {
            "type": "locale",
            "key": " └ 󰗊 ",
            "keyColor": "38;2;224;255;255",
            "format": "\u001b[38;2;200;245;255m{1}",
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        },
    ]
}
